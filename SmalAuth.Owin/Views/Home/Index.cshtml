@model SmalAuth.Owin.Models.SamlUserInfo
@{
    ViewBag.Title = "SAML user";
}

<h1>SAML user (OWIN 4.6.1)</h1>
<p>Signed in through Entra ID with SAML 2.0 using Sustainsys.Saml2.Owin 2.10.0. MFA is applied by Entra when Conditional Access requires it.</p>

<dl>
    <dt>Name</dt>
    <dd>@(string.IsNullOrEmpty(Model.Name) ? "(none)" : Model.Name)</dd>
    <dt>NameID</dt>
    <dd>@(string.IsNullOrEmpty(Model.NameId) ? "(none)" : Model.NameId)</dd>
    <dt>Azure ID</dt>
    <dd>@(string.IsNullOrEmpty(Model.AzureId) ? "(claim not present — confirm the Entra unique identifier)" : Model.AzureId)</dd>
    <dt>Email</dt>
    <dd>@(string.IsNullOrEmpty(Model.Email) ? "(none)" : Model.Email)</dd>
    <dt>Authentication type</dt>
    <dd>@(string.IsNullOrEmpty(Model.AuthenticationType) ? "(none)" : Model.AuthenticationType)</dd>
</dl>

<h2>Assertion claims</h2>
@if (Model.Claims != null && Model.Claims.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Type</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model.Claims)
            {
                <tr>
                    <td>@claim.Type</td>
                    <td>@claim.Value</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No claims were present on the session principal.</p>
}
