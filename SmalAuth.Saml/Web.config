<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="system.identityModel" type="System.IdentityModel.Configuration.SystemIdentityModelSection, System.IdentityModel, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
    <section name="system.identityModel.services" type="System.IdentityModel.Services.Configuration.SystemIdentityModelServicesSection, System.IdentityModel.Services, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
    <section name="sustainsys.saml2" type="Sustainsys.Saml2.Configuration.SustainsysSaml2Section, Sustainsys.Saml2" />
  </configSections>

  <!--
    POC #2 — MVC 5 + SAML 2.0 + Entra + MFA
    Replace YOUR-TENANT-ID with the Entra tenant ID from the office email.
    Register these exact values on the Entra Enterprise Application:
      Identifier (SP Entity ID):  https://localhost:44322/Saml2
      Reply URL (ACS):            https://localhost:44322/Saml2/Acs
    Unique user identifier is read from the Azure objectidentifier claim, then NameID.
    RSA validation is intentionally out of scope for this spike.
  -->
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />

    <add key="ida:TenantId"
         value="32761e73-fd53-4cfd-9dfe-946febf1aae4" />

    <add key="saml:SpEntityId"
         value="https://localhost:44322/Saml2" />

    <add key="saml:AcsUrl"
         value="https://localhost:44322/Saml2/Acs" />

    <add key="saml:ReturnUrl"
         value="https://localhost:44322/" />

    <add key="saml:IdpEntityId"
         value="https://sts.windows.net/32761e73-fd53-4cfd-9dfe-946febf1aae4/" />

    <add key="saml:LoginUrl"
         value="https://login.microsoftonline.com/32761e73-fd53-4cfd-9dfe-946febf1aae4/saml2" />

    <add key="saml:LogoutUrl"
         value="https://login.microsoftonline.com/32761e73-fd53-4cfd-9dfe-946febf1aae4/saml2" />

    <add key="saml:MetadataUrl"
         value="https://login.microsoftonline.com/32761e73-fd53-4cfd-9dfe-946febf1aae4/federationmetadata/2007-06/federationmetadata.xml?appid=82009cdd-38d2-4416-8d76-1ff399842494" />
</appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="None" />
    <authorization>
      <allow users="*" />
    </authorization>
    <customErrors mode="Off" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
      </namespaces>
    </pages>
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <add name="SessionAuthenticationModule" type="System.IdentityModel.Services.SessionAuthenticationModule, System.IdentityModel.Services, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" preCondition="managedHandler" />
    </modules>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <system.identityModel>
    <identityConfiguration>
      <securityTokenHandlers>
        <add type="System.IdentityModel.Services.Tokens.MachineKeySessionSecurityTokenHandler, System.IdentityModel.Services, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <remove type="System.IdentityModel.Tokens.SessionSecurityTokenHandler, System.IdentityModel, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </securityTokenHandlers>
      <audienceUris>
        <add value="https://localhost:44322/Saml2" />
      </audienceUris>
      <certificateValidation certificateValidationMode="None" />
    </identityConfiguration>
  </system.identityModel>

  <system.identityModel.services>
    <federationConfiguration>
      <cookieHandler requireSsl="true" name="SmalAuth.Saml" />
    </federationConfiguration>
  </system.identityModel.services>

  <sustainsys.saml2 entityId="https://localhost:44322/Saml2"
                    returnUrl="https://localhost:44322/"
                    publicOrigin="https://localhost:44322/"
                    authenticateRequestSigningBehavior="Never">
    <identityProviders>
      <add entityId="https://sts.windows.net/32761e73-fd53-4cfd-9dfe-946febf1aae4/"
           metadataLocation="https://login.microsoftonline.com/32761e73-fd53-4cfd-9dfe-946febf1aae4/federationmetadata/2007-06/federationmetadata.xml?appid=82009cdd-38d2-4416-8d76-1ff399842494"
           loadMetadata="true"
           allowUnsolicitedAuthnResponse="true"
           binding="HttpRedirect" />
    </identityProviders>
  </sustainsys.saml2>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.3.0.0" newVersion="5.3.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
